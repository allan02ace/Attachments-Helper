rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user can read and write only their own saved filer profiles.
    // The app stores these at birdat_users/{uid}.
    match /birdat_users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
